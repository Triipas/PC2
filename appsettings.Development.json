{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=app.db"
  },
  "Redis": {
    "ConnectionString": "redis://default:YOUR_PASSWORD@YOUR_REDIS_HOST:YOUR_PORT",
    "InstanceName": "PortalInmobiliario_Dev",
    "DefaultCacheTimeMinutes": 1
  },
  "Session": {
    "TimeoutMinutes": 60,
    "CookieName": "PortalInmobiliario.Session"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "StackExchange.Redis": "Information"
    }
  }
}