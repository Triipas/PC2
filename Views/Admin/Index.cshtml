@using PC2.Services

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portal Inmobiliario</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PC2.styles.css" asp-append-version="true" />
    <!-- Font Awesome para los iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-home me-2"></i>Portal Inmobiliario
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-1"></i>Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Inmuebles" asp-action="Index">
                                <i class="fas fa-search me-1"></i>Catálogo
                            </a>
                        </li>
                        
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user me-1"></i>Mi Cuenta
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Visitas" asp-action="MisVisitas">
                                            <i class="fas fa-calendar-alt me-2"></i>Mis Visitas
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Reservas" asp-action="MisReservas">
                                            <i class="fas fa-clock me-2"></i>Mis Reservas
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                                            <i class="fas fa-cog me-2"></i>Configuración
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <!-- Admin menu (temporal para la Pregunta 4) -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-tools me-1"></i>Admin
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Index">
                                            <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Inmuebles">
                                            <i class="fas fa-building me-2"></i>Gestionar Inmuebles
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Cache">
                                            <i class="fas fa-memory me-2"></i>Gestión de Caché
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">
                                <i class="fas fa-shield-alt me-1"></i>Privacidad
                            </a>
                        </li>
                    </ul>

                    <!-- Último inmueble visitado -->
                    @{
                        var sessionService = Context.RequestServices.GetService<ISessionService>();
                        var ultimoInmueble = await sessionService!.ObtenerUltimoInmuebleAsync();
                    }

                    @if (ultimoInmueble.HasValue)
                    {
                        <div class="navbar-nav me-3">
                            <div class="nav-item">
                                <a class="btn btn-outline-primary btn-sm" asp-controller="Inmuebles" asp-action="Details" asp-route-id="@ultimoInmueble.Value.Id" 
                                   title="Volver al último inmueble visitado">
                                    <i class="fas fa-arrow-left me-1"></i>
                                    Volver a "@(ultimoInmueble.Value.Titulo.Length > 20 ? ultimoInmueble.Value.Titulo.Substring(0, 20) + "..." : ultimoInmueble.Value.Titulo)"
                                </a>
                            </div>
                        </div>
                    }

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    
    <!-- Información de caché y sesión (solo en desarrollo) -->
    @if (ViewBag.DatosDesdeCache != null || ViewBag.TiempoCarga != null)
    {
        <div class="container-fluid">
            <div class="alert alert-info alert-dismissible fade show py-2" role="alert">
                <small>
                    <i class="fas fa-info-circle me-1"></i>
                    <strong>Debug:</strong>
                    @if (ViewBag.DatosDesdeCache == true)
                    {
                        <span class="badge bg-success me-1">CACHÉ</span>
                    }
                    else
                    {
                        <span class="badge bg-warning me-1">BD</span>
                    }
                    Tiempo: @ViewBag.TiempoCarga ms
                    @if (ultimoInmueble.HasValue)
                    {
                        <span class="ms-2">| <i class="fas fa-bookmark me-1"></i>Sesión activa</span>
                    }
                </small>
                <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    &copy; @DateTime.Now.Year - Portal Inmobiliario - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
                <div class="col-md-6 text-end">
                    <small class="text-muted">
                        <i class="fas fa-phone me-1"></i>+51 999 999 999 |
                        <i class="fas fa-envelope me-1"></i>contacto@PC2.com
                    </small>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>