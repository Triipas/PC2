@model PC2.Models.Inmueble

@{
    ViewData["Title"] = "Detalle del Inmueble";
    var inmueblesSimilares = ViewBag.InmueblesSimilares as IEnumerable<PC2.Models.Inmueble> ?? new List<PC2.Models.Inmueble>();
}

<div class="container">
    <!-- Navegación de regreso -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Inmuebles" asp-action="Index">Catálogo</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Titulo</li>
                </ol>
            </nav>
            
            <div class="d-flex justify-content-between align-items-center">
                <a asp-controller="Inmuebles" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Volver al catálogo
                </a>
                <small class="text-muted">Código: <strong>@Model.Codigo</strong></small>
            </div>
        </div>
    </div>

    <!-- Mensajes de feedback -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Contenido principal -->
    <div class="row">
        <!-- Imagen principal -->
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow">
                @if (!string.IsNullOrEmpty(Model.Imagen))
                {
                    <img src="@Model.Imagen" class="card-img-top rounded" alt="@Model.Titulo" 
                         style="height: 400px; object-fit: cover;">
                }
                else
                {
                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center rounded" 
                         style="height: 400px;">
                        <div class="text-center">
                            <i class="fas fa-image fa-4x text-muted mb-3"></i>
                            <p class="text-muted">Sin imagen disponible</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Información y acciones -->
        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow h-100">
                <div class="card-body">
                    <!-- Título y precio -->
                    <div class="mb-4">
                        <span class="badge bg-primary fs-6 mb-2">@Model.Tipo</span>
                        <h2 class="card-title mb-3">@Model.Titulo</h2>
                        <div class="display-4 text-primary fw-bold mb-2">
                            @Model.Precio.ToString("C")
                        </div>
                        <p class="text-muted">
                            <i class="fas fa-calculator me-1"></i>
                            Aprox. @((Model.Precio / Model.MetrosCuadrados).ToString("C"))/m²
                        </p>
                    </div>

                    <!-- Estado de reserva -->
                    <div id="estadoReserva" class="mb-3">
                        <!-- Se carga dinámicamente -->
                    </div>

                    <!-- Ubicación -->
                    <div class="mb-4">
                        <h6 class="text-uppercase fw-bold mb-2">Ubicación</h6>
                        <p class="mb-1">
                            <i class="fas fa-map-marker-alt text-danger me-2"></i>
                            @Model.Direccion
                        </p>
                        <p class="text-muted">@Model.Ciudad</p>
                    </div>

                    <!-- Características -->
                    <div class="mb-4">
                        <h6 class="text-uppercase fw-bold mb-3">Características</h6>
                        <div class="row text-center">
                            @if (Model.Dormitorios > 0)
                            {
                                <div class="col-4">
                                    <div class="p-3 bg-light rounded">
                                        <i class="fas fa-bed fa-2x text-primary mb-2"></i>
                                        <div class="fw-bold">@Model.Dormitorios</div>
                                        <small class="text-muted">@(Model.Dormitorios == 1 ? "Dormitorio" : "Dormitorios")</small>
                                    </div>
                                </div>
                            }
                            
                            <div class="col-4">
                                <div class="p-3 bg-light rounded">
                                    <i class="fas fa-bath fa-2x text-primary mb-2"></i>
                                    <div class="fw-bold">@Model.Banos</div>
                                    <small class="text-muted">@(Model.Banos == 1 ? "Baño" : "Baños")</small>
                                </div>
                            </div>
                            
                            <div class="col-4">
                                <div class="p-3 bg-light rounded">
                                    <i class="fas fa-ruler-combined fa-2x text-primary mb-2"></i>
                                    <div class="fw-bold">@Model.MetrosCuadrados</div>
                                    <small class="text-muted">m² construidos</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Botones de acción principal -->
                    <div class="d-grid gap-2" id="botonesAccion">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Visitas" asp-action="Agendar" asp-route-id="@Model.Id" 
                               class="btn btn-success btn-lg">
                                <i class="fas fa-calendar-plus me-2"></i>Agendar Visita
                            </a>
                            
                            <!-- Botón de reservar (se muestra/oculta dinámicamente) -->
                            <form asp-controller="Reservas" asp-action="Crear" asp-route-id="@Model.Id" 
                                  method="post" id="formReservar" style="display: none;">
                                <button type="submit" class="btn btn-outline-primary w-100">
                                    <i class="fas fa-clock me-2"></i>Reservar por 48h
                                </button>
                            </form>
                            
                            <!-- Información de reserva existente -->
                            <div id="infoReservaExistente" style="display: none;">
                                <div class="alert alert-warning mb-2">
                                    <i class="fas fa-clock me-2"></i>
                                    <strong>Inmueble Reservado</strong>
                                    <div id="tiempoRestante" class="small mt-1">
                                        Tiempo restante: <span id="countdown"></span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a asp-area="Identity" asp-page="/Account/Login" 
                               asp-route-returnUrl="@Context.Request.Path" 
                               class="btn btn-success btn-lg">
                                <i class="fas fa-sign-in-alt me-2"></i>Iniciar sesión para agendar
                            </a>
                        }
                        
                        <button type="button" class="btn btn-outline-secondary" onclick="contactarAsesor()">
                            <i class="fas fa-phone me-2"></i>Contactar Asesor
                        </button>
                    </div>

                    <!-- Información adicional -->
                    <div class="mt-4">
                        <small class="text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            Esta propiedad está disponible para visitas y reservas.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Propiedades similares -->
    @if (inmueblesSimilares.Any())
    {
        <div class="row mt-5">
            <div class="col-12">
                <h4 class="mb-4">
                    <i class="fas fa-home me-2"></i>Propiedades Similares
                </h4>
                
                <div class="row">
                    @foreach (var similar in inmueblesSimilares)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 shadow-sm">
                                <div class="position-relative">
                                    @if (!string.IsNullOrEmpty(similar.Imagen))
                                    {
                                        <img src="@similar.Imagen" class="card-img-top" alt="@similar.Titulo" 
                                             style="height: 200px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" 
                                             style="height: 200px;">
                                            <i class="fas fa-image fa-2x text-muted"></i>
                                        </div>
                                    }
                                    <div class="position-absolute top-0 end-0 m-2">
                                        <span class="badge bg-success">@similar.Precio.ToString("C")</span>
                                    </div>
                                </div>
                                
                                <div class="card-body">
                                    <h6 class="card-title">@similar.Titulo</h6>
                                    <p class="card-text text-muted small mb-2">
                                        <i class="fas fa-map-marker-alt me-1"></i>
                                        @similar.Ciudad
                                    </p>
                                    
                                    <div class="d-flex justify-content-between text-center mb-3">
                                        @if (similar.Dormitorios > 0)
                                        {
                                            <div>
                                                <small class="text-muted d-block">Dorm.</small>
                                                <strong>@similar.Dormitorios</strong>
                                            </div>
                                        }
                                        <div>
                                            <small class="text-muted d-block">Baños</small>
                                            <strong>@similar.Banos</strong>
                                        </div>
                                        <div>
                                            <small class="text-muted d-block">m²</small>
                                            <strong>@similar.MetrosCuadrados</strong>
                                        </div>
                                    </div>
                                    
                                    <a asp-action="Details" asp-route-id="@similar.Id" 
                                       class="btn btn-outline-primary btn-sm w-100">
                                        Ver Detalles
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            verificarEstadoReserva();
            
            // Verificar estado cada 30 segundos
            setInterval(verificarEstadoReserva, 30000);
        });

        function verificarEstadoReserva() {
            fetch('@Url.Action("EstadoReserva", "Reservas", new { id = Model.Id })')
                .then(response => response.json())
                .then(data => {
                    const formReservar = document.getElementById('formReservar');
                    const infoReservaExistente = document.getElementById('infoReservaExistente');
                    const estadoReserva = document.getElementById('estadoReserva');
                    
                    if (data.reservado) {
                        // Mostrar información de reserva existente
                        formReservar.style.display = 'none';
                        infoReservaExistente.style.display = 'block';
                        
                        // Iniciar countdown
                        if (data.tiempoRestante) {
                            iniciarCountdown(data.tiempoRestante.totalSegundos);
                        }
                        
                        // Mostrar estado en la parte superior
                        estadoReserva.innerHTML = `
                            <div class="alert alert-warning">
                                <i class="fas fa-clock me-2"></i>
                                <strong>Inmueble Reservado</strong>
                                <div class="small">Este inmueble está temporalmente reservado</div>
                            </div>`;
                    } else {
                        // Mostrar botón de reservar
                        formReservar.style.display = 'block';
                        infoReservaExistente.style.display = 'none';
                        estadoReserva.innerHTML = `
                            <div class="alert alert-success">
                                <i class="fas fa-check-circle me-2"></i>
                                <strong>Disponible</strong>
                                <div class="small">Este inmueble está disponible para reservar</div>
                            </div>`;
                    }
                })
                .catch(error => {
                    console.error('Error al verificar estado de reserva:', error);
                });
        }

        function iniciarCountdown(segundosRestantes) {
            const countdownElement = document.getElementById('countdown');
            
            function actualizarCountdown() {
                if (segundosRestantes <= 0) {
                    verificarEstadoReserva(); // Refrescar estado
                    return;
                }
                
                const horas = Math.floor(segundosRestantes / 3600);
                const minutos = Math.floor((segundosRestantes % 3600) / 60);
                const segundos = segundosRestantes % 60;
                
                countdownElement.textContent = `${horas}h ${minutos}m ${segundos}s`;
                
                segundosRestantes--;
                setTimeout(actualizarCountdown, 1000);
            }
            
            actualizarCountdown();
        }
        
        function contactarAsesor() {
            alert('Contactar asesor: Esta funcionalidad se puede integrar con un sistema de chat o formulario de contacto.');
        }
    </script>
}

@section Styles {
    <style>
        .card {
            transition: transform 0.2s ease-in-out;
        }
        
        .card:hover {
            transform: translateY(-2px);
        }
        
        .btn {
            transition: all 0.2s ease-in-out;
        }
        
        .badge {
            font-size: 0.8rem;
        }

        .alert {
            animation: fadeIn 0.5s ease-in;
        }

        #countdown {
            font-family: monospace;
            font-weight: bold;
        }
    </style>
}