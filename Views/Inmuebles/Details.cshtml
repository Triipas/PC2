@model PC2.Models.Inmueble

@{
    ViewData["Title"] = "Detalle del Inmueble";
    var inmueblesSimilares = ViewBag.InmueblesSimilares as IEnumerable<PC2.Models.Inmueble> ?? new List<PC2.Models.Inmueble>();
}

<div class="container">
    <!-- Navegación de regreso -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Inmuebles" asp-action="Index">Catálogo</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Titulo</li>
                </ol>
            </nav>
            
            <div class="d-flex justify-content-between align-items-center">
                <a asp-controller="Inmuebles" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Volver al catálogo
                </a>
                <small class="text-muted">Código: <strong>@Model.Codigo</strong></small>
            </div>
        </div>
    </div>

    <!-- Contenido principal -->
    <div class="row">
        <!-- Imagen principal -->
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow">
                @if (!string.IsNullOrEmpty(Model.Imagen))
                {
                    <img src="@Model.Imagen" class="card-img-top rounded" alt="@Model.Titulo" 
                         style="height: 400px; object-fit: cover;">
                }
                else
                {
                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center rounded" 
                         style="height: 400px;">
                        <div class="text-center">
                            <i class="fas fa-image fa-4x text-muted mb-3"></i>
                            <p class="text-muted">Sin imagen disponible</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Información y acciones -->
        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow h-100">
                <div class="card-body">
                    <!-- Título y precio -->
                    <div class="mb-4">
                        <span class="badge bg-primary fs-6 mb-2">@Model.Tipo</span>
                        <h2 class="card-title mb-3">@Model.Titulo</h2>
                        <div class="display-4 text-primary fw-bold mb-2">
                            @Model.Precio.ToString("C")
                        </div>
                        <p class="text-muted">
                            <i class="fas fa-calculator me-1"></i>
                            Aprox. @((Model.Precio / Model.MetrosCuadrados).ToString("C"))/m²
                        </p>
                    </div>

                    <!-- Ubicación -->
                    <div class="mb-4">
                        <h6 class="text-uppercase fw-bold mb-2">Ubicación</h6>
                        <p class="mb-1">
                            <i class="fas fa-map-marker-alt text-danger me-2"></i>
                            @Model.Direccion
                        </p>
                        <p class="text-muted">@Model.Ciudad</p>
                    </div>

                    <!-- Características -->
                    <div class="mb-4">
                        <h6 class="text-uppercase fw-bold mb-3">Características</h6>
                        <div class="row text-center">
                            @if (Model.Dormitorios > 0)
                            {
                                <div class="col-4">
                                    <div class="p-3 bg-light rounded">
                                        <i class="fas fa-bed fa-2x text-primary mb-2"></i>
                                        <div class="fw-bold">@Model.Dormitorios</div>
                                        <small class="text-muted">@(Model.Dormitorios == 1 ? "Dormitorio" : "Dormitorios")</small>
                                    </div>
                                </div>
                            }
                            
                            <div class="col-4">
                                <div class="p-3 bg-light rounded">
                                    <i class="fas fa-bath fa-2x text-primary mb-2"></i>
                                    <div class="fw-bold">@Model.Banos</div>
                                    <small class="text-muted">@(Model.Banos == 1 ? "Baño" : "Baños")</small>
                                </div>
                            </div>
                            
                            <div class="col-4">
                                <div class="p-3 bg-light rounded">
                                    <i class="fas fa-ruler-combined fa-2x text-primary mb-2"></i>
                                    <div class="fw-bold">@Model.MetrosCuadrados</div>
                                    <small class="text-muted">m² construidos</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Botón de acción principal -->
                    <div class="d-grid gap-2">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <button type="button" class="btn btn-success btn-lg" onclick="agendarVisita()">
                                <i class="fas fa-calendar-plus me-2"></i>Agendar Visita
                            </button>
                            <button type="button" class="btn btn-outline-primary" onclick="reservarInmueble()">
                                <i class="fas fa-clock me-2"></i>Reservar por 48h
                            </button>
                        }
                        else
                        {
                            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-success btn-lg">
                                <i class="fas fa-sign-in-alt me-2"></i>Iniciar sesión para agendar
                            </a>
                        }
                        
                        <button type="button" class="btn btn-outline-secondary" onclick="contactarAsesor()">
                            <i class="fas fa-phone me-2"></i>Contactar Asesor
                        </button>
                    </div>

                    <!-- Información adicional -->
                    <div class="mt-4">
                        <small class="text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            Esta propiedad está disponible para visitas y reservas.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Propiedades similares -->
    @if (inmueblesSimilares.Any())
    {
        <div class="row mt-5">
            <div class="col-12">
                <h4 class="mb-4">
                    <i class="fas fa-home me-2"></i>Propiedades Similares
                </h4>
                
                <div class="row">
                    @foreach (var similar in inmueblesSimilares)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 shadow-sm">
                                <div class="position-relative">
                                    @if (!string.IsNullOrEmpty(similar.Imagen))
                                    {
                                        <img src="@similar.Imagen" class="card-img-top" alt="@similar.Titulo" 
                                             style="height: 200px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" 
                                             style="height: 200px;">
                                            <i class="fas fa-image fa-2x text-muted"></i>
                                        </div>
                                    }
                                    <div class="position-absolute top-0 end-0 m-2">
                                        <span class="badge bg-success">@similar.Precio.ToString("C")</span>
                                    </div>
                                </div>
                                
                                <div class="card-body">
                                    <h6 class="card-title">@similar.Titulo</h6>
                                    <p class="card-text text-muted small mb-2">
                                        <i class="fas fa-map-marker-alt me-1"></i>
                                        @similar.Ciudad
                                    </p>
                                    
                                    <div class="d-flex justify-content-between text-center mb-3">
                                        @if (similar.Dormitorios > 0)
                                        {
                                            <div>
                                                <small class="text-muted d-block">Dorm.</small>
                                                <strong>@similar.Dormitorios</strong>
                                            </div>
                                        }
                                        <div>
                                            <small class="text-muted d-block">Baños</small>
                                            <strong>@similar.Banos</strong>
                                        </div>
                                        <div>
                                            <small class="text-muted d-block">m²</small>
                                            <strong>@similar.MetrosCuadrados</strong>
                                        </div>
                                    </div>
                                    
                                    <a asp-action="Details" asp-route-id="@similar.Id" 
                                       class="btn btn-outline-primary btn-sm w-100">
                                        Ver Detalles
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Scripts para las funcionalidades -->
<script>
    function agendarVisita() {
        // Placeholder para la funcionalidad de agendar visita (Pregunta 3)
        alert('Funcionalidad de agendar visita se implementará en la siguiente pregunta.');
    }
    
    function reservarInmueble() {
        // Placeholder para la funcionalidad de reserva (Pregunta 3)
        alert('Funcionalidad de reserva se implementará en la siguiente pregunta.');
    }
    
    function contactarAsesor() {
        alert('Contactar asesor: Esta funcionalidad se puede integrar con un sistema de chat o formulario de contacto.');
    }
</script>

@section Styles {
    <style>
        .card {
            transition: transform 0.2s ease-in-out;
        }
        
        .card:hover {
            transform: translateY(-2px);
        }
        
        .btn {
            transition: all 0.2s ease-in-out;
        }
        
        .badge {
            font-size: 0.8rem;
        }
    </style>
}