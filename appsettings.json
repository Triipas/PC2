{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=app.db"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "PortalInmobiliario",
    "DefaultCacheTimeMinutes": 1
  },
  "Session": {
    "TimeoutMinutes": 60,
    "CookieName": "PortalInmobiliario.Session"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "StackExchange.Redis": "Warning"
    }
  },
  "AllowedHosts": "*"
}